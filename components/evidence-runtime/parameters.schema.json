{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Vector UCI evidence measurements",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "initialTimeMs": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "incrementMs": {"type": "integer", "minimum": 0, "maximum": 60000},
    "maxPlies": {"type": "integer", "minimum": 1, "maximum": 2048},
    "responseTimeoutMs": {"type": "integer", "minimum": 100, "maximum": 300000},
    "maxDurationMs": {"type": "integer", "minimum": 1000, "maximum": 3600000},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
    "movetimesMs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 1, "maximum": 60000}},
    "openings": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["id", "moves"], "properties": {
      "id": {"type": "string", "minLength": 1, "maxLength": 256},
      "fen": {"type": "string", "minLength": 1, "maxLength": 256},
      "moves": {"type": "array", "maxItems": 1024, "items": {"type": "string", "minLength": 4, "maxLength": 5}}
    }}},
    "candidateOptions": {"type": "object", "properties": {}, "required": [], "maxProperties": 64, "additionalProperties": {"type": ["string", "integer", "boolean"], "maxLength": 512, "minimum": -9007199254740991, "maximum": 9007199254740991}},
    "controlOptions": {"type": "object", "properties": {}, "required": [], "maxProperties": 64, "additionalProperties": {"type": ["string", "integer", "boolean"], "maxLength": 512, "minimum": -9007199254740991, "maximum": 9007199254740991}}
  }
}
